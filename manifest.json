{
  "manifest_version": 3,
  "name": "Head-Controlled Cursor",
  "version": "0.1.0",
  "description": "Move a virtual cursor with head-pose tracking.",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "offscreen" 
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/cursor.css",
        "content/tracker.js",
        "src/offscreen/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}