{
  "manifest_version": 3,
  "name": "Head-Controlled Cursor",
  "version": "0.1.0",
  "description": "Move a virtual cursor with head-pose tracking.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_popup": "src/popup/index.html" },
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["content/*"],
      "matches": ["<all_urls>"]
    }
  ]
}

