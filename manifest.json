{
  "manifest_version": 3,
  "name": "Head-Controlled Cursor",
  "version": "0.7.2",
  "description": "Move a virtual cursor with head-pose tracking.",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/permissions/camera.html",
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
 "content_scripts": [
    {
      "matches": ["https://head-control-website.vercel.app/*"],
      "js": ["src/content/calibration-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/cursor.css",
        "content/tabstrip.css",
        "content/keyboard.css",
        "vendor/tasks-vision/wasm/*",
        "vendor/models/face_landmarker.task"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Activate the Extension"
    },
    "toggle-tracking": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Start/Stop Head Tracking"
    }
  }
}
