{
  "manifest_version": 3,
  "name": "Íris",
  "version": "1.0.0",
  "description": "Controle o cursor do navegador com movimentos da cabeça e gestos faciais.",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/permissions/camera.html",
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["src/content/boot.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/cursor.css",
        "vendor/tasks-vision/wasm/*",
        "vendor/models/face_landmarker.task"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Abrir o popup do Íris"
    },
    "toggle-tracking": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Iniciar / parar o rastreamento"
    }
  }
}
